# 复制本文件并重命名为 .env 后，根据实际情况填写对应配置。
# 请勿将包含真实密钥的 .env 文件提交到 Git 仓库。

# ==========================================
# 数据库配置
# ==========================================

# PostgreSQL 数据库连接地址
DATABASE_URL=postgresql://xxx

# ==========================================
# Better Auth 配置：https://better-auth.com/
# ==========================================

# Better Auth 密钥
BETTER_AUTH_SECRET=

# Better Auth 服务地址
BETTER_AUTH_URL=http://localhost:5173

# Better Auth API Key
BETTER_AUTH_API_KEY=

# Better Auth Identify 服务地址
BETTER_AUTH_IDENTIFY_URL=

# 管理员用户 ID（多个使用英文逗号分隔）
BETTER_AUTH_ADMIN_USER_IDS=

# （可选）新用户默认角色 ID，新用户将自动加入该角色
BETTER_AUTH_DEFAULT_ROLE_ID=

# ==========================================
# 邮件服务（Resend）
# ==========================================

# Resend API Key
NUXT_RESEND_API_KEY=

# ==========================================
# 第三方登录（OAuth）
# ==========================================

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Hugging Face
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=

# GitHub Personal Access Token
GITHUB_TOKEN=

# ==========================================
# 后台配置
# ==========================================

# 后台管理员邮箱（多个使用英文逗号分隔），可选，线上可以操作的用户邮箱，多个邮箱使用英文逗号分隔
NUXT_ADMIN_EMAIL=

# ==========================================
# 网站配置
# ==========================================

# 网站地址
NUXT_SITE_URL=http://localhost:5173

# 网站名称
NUXT_SITE_NAME=Better Nuxt

# 网站描述
NUXT_SITE_DESCRIPTION=一个现代化的全栈后台管理系统，前端基于 Nuxt.js 和 Nuxt UI 构建，后端采用 Better Auth、Drizzle ORM 与 PostgreSQL。

# 网站关键词（多个使用英文逗号分隔）
NUXT_SITE_KEYWORDS=Nuxt.js,Better Auth,Nuxt UI,Drizzle ORM,PostgreSQL

# Vercel 部署地址（本地开发可保持 localhost）
VERCEL_URL=http://localhost:5173

# ==========================================
# 网站统计
# ==========================================

# Microsoft Clarity
NUXT_PUBLIC_SCRIPTS_CLARITY_ID=

# Google Analytics（GA4）
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=

# Cloudflare Web Analytics
NUXT_PUBLIC_SCRIPTS_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# ==========================================
# Vercel Blob
# ==========================================

# Vercel Blob 读写 Token
BLOB_READ_WRITE_TOKEN=

# Open Graph 图片生成密钥
NUXT_OG_IMAGE_SECRET=

# ==========================================
# Cloudflare Turnstile
# ==========================================

# Turnstile 站点 Key（公开）
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Turnstile Secret Key（私密）
TURNSTILE_SECRET_KEY=
# 邮件发件人（可选，默认 no-reply@baiwumm.com）
NUXT_MAIL_FROM=
